# Supabase: use Connect > Session pooler (IPv4), not the Direct connection.
# Convert its URI to JDBC form and keep the pooler host, port 5432, and database name.
# Example shape: jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_URL=
# Supabase session pooler username is postgres.<project-ref>.
DB_USERNAME=
DB_PASSWORD=

# Optional: leave blank to disable shared spell catalog writes.
SPELL_ADMIN_TOKEN=

# Port exposed on this computer.
HOST_PORT=8080
